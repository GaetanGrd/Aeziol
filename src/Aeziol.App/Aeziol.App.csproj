<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>0.9.0-beta.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon Condition="Exists('Assets/Aeziol.ico')">Assets/Aeziol.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Linguini.Bundle" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Aeziol.Core/Aeziol.Core.csproj" />
    <ProjectReference Include="../Aeziol.Infrastructure.Discord/Aeziol.Infrastructure.Discord.csproj" />
    <ProjectReference Include="../Aeziol.Infrastructure.Windows/Aeziol.Infrastructure.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Localization/**/*.ftl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets/Audio/*.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets/Audio/*.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets/Brand/*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets/Aeziol.ico" />
    <Resource Include="Assets/Brand/aeziol-app-icon-256.png" />
    <Resource Include="Assets/Brand/elgo-logo-square.png" />
    <Resource Include="Assets/Audio/onde-doree-cover.png" />
    <Resource Include="Assets/Flags/*.png" />
  </ItemGroup>
</Project>
