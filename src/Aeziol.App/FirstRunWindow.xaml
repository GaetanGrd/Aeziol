<Window x:Class="Aeziol.App.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="640" Height="546" MinWidth="600" MinHeight="516"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource AeziolCanvas}"
        Foreground="{DynamicResource AeziolText}"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="0"
                            CornerRadius="14" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AeziolCanvas}"
            BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Background="{DynamicResource AeziolRail}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="17,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="21" Height="21" Source="{DynamicResource AeziolCicadaDrawing}" />
                    <TextBlock Text="AEZIOL" Margin="9,0,0,0" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource AeziolGoldBright}" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="FirstRunCloseButton" Grid.Column="1" Margin="6"
                        Style="{StaticResource WindowButton}" Content="×"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" />
            </Grid>

            <Grid Grid.Row="1" Margin="34,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border CornerRadius="24" Background="{DynamicResource AeziolRaised}"
                        BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="1">
                    <Grid>
                        <Image Width="112" Height="112" VerticalAlignment="Top" Margin="0,58,0,0"
                               Source="{DynamicResource AeziolCicadaDrawing}" />
                        <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,27">
                            <TextBlock Text="AEZIOL" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource AeziolGoldBright}" />
                            <TextBlock x:Name="StepNumberText" Text="01" Margin="0,6,0,0" FontSize="10"
                                       Foreground="{DynamicResource AeziolDim}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="EssentialsStep" Grid.Column="1" Margin="30,2,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="WelcomeTitleText" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="WelcomeHelpText" Margin="0,7,0,0" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,24,0,0">
                        <TextBlock x:Name="LanguageLabel" Style="{StaticResource SectionLabel}" />
                        <ListBox x:Name="FirstRunLanguageList" Margin="0,7,0,0" MaxHeight="168"
                                 Style="{StaticResource LanguageChoiceList}"
                                 ItemTemplate="{StaticResource LanguageChoiceCard}"
                                 SelectedValuePath="Code" SelectionChanged="OnLanguageChanged" />
                        <Border Margin="0,20,0,0" Padding="15" CornerRadius="14"
                                Background="{DynamicResource AeziolSurface}"
                                BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox x:Name="AutostartCheck" Style="{StaticResource ToggleSwitch}" />
                                <Border Margin="0,14,0,14" BorderBrush="{DynamicResource AeziolBorderSoft}"
                                        BorderThickness="0,1,0,0" />
                                <CheckBox x:Name="ReduceAnimationsCheck" Style="{StaticResource ToggleSwitch}"
                                          Click="OnReduceAnimationsChanged" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="LocalDataHintText" Margin="2,13,0,0" FontSize="10"
                                   Foreground="{DynamicResource AeziolDim}" LineHeight="15" />
                    </StackPanel>
                    <Button x:Name="ContinueButton" Grid.Row="2" HorizontalAlignment="Right" MinWidth="132"
                            Style="{StaticResource PrimaryButton}" Click="OnContinue" />
                </Grid>

                <Grid x:Name="MusicStep" Grid.Column="1" Margin="30,2,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="MusicTitleText" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="MusicHelpText" Margin="0,7,0,0" Style="{StaticResource PageSubtitle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,24,0,0">
                        <Border Padding="14" CornerRadius="16"
                                Background="{DynamicResource AeziolSurface}"
                                BorderBrush="{DynamicResource AeziolBorder}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="76" Height="76" CornerRadius="14" ClipToBounds="True"
                                        BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="1">
                                    <Image Stretch="UniformToFill"
                                           Source="/Aeziol.App;component/Assets/Audio/onde-doree-cover.png" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="6,4,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="MusicTrackTitleText" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MusicCreditText" Margin="0,4,0,0" FontSize="10"
                                               Foreground="{DynamicResource AeziolDim}" />
                                    <TextBlock x:Name="MusicPurposeText" Margin="0,9,0,0" FontSize="10"
                                               Foreground="{DynamicResource AeziolMuted}" TextWrapping="Wrap"
                                               LineHeight="15" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Margin="0,14,0,0" Padding="15" CornerRadius="14"
                                Background="{DynamicResource AeziolRaised}"
                                BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="1">
                            <CheckBox x:Name="MusicEnabledCheck" Style="{StaticResource ToggleSwitch}"
                                      Click="OnMusicEnabledChanged" />
                        </Border>
                        <TextBlock x:Name="MusicChoiceHintText" Margin="2,12,0,0" FontSize="10"
                                   Foreground="{DynamicResource AeziolDim}" TextWrapping="Wrap" LineHeight="15" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="MusicBackButton" Margin="0,0,8,0" MinWidth="96"
                                Style="{StaticResource ActionButton}" Click="OnMusicBack" />
                        <Button x:Name="MusicContinueButton" MinWidth="132"
                                Style="{StaticResource PrimaryButton}" Click="OnMusicContinue" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="PaletteStep" Grid.Column="1" Margin="30,2,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PaletteTitleText" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="PaletteHelpText" Margin="0,7,0,0" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,24,0,0">
                        <TextBlock x:Name="PaletteLabelText" Style="{StaticResource SectionLabel}" />
                        <ComboBox x:Name="FirstRunThemeCombo" Margin="0,7,0,0" SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Tag="Elgo"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Margin="0,0,9,0" Fill="#F2D98A" /><TextBlock Text="Elgo" /></StackPanel></ComboBoxItem>
                            <ComboBoxItem Tag="Elna"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Margin="0,0,9,0" Fill="#DEBD68" /><TextBlock Text="Elna" /></StackPanel></ComboBoxItem>
                            <ComboBoxItem Tag="Ilyors"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Margin="0,0,9,0" Fill="#AFC7A4" /><TextBlock Text="Ilyors" /></StackPanel></ComboBoxItem>
                            <ComboBoxItem Tag="Cherry"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Margin="0,0,9,0" Fill="#6D160E" /><TextBlock Text="Cherry" /></StackPanel></ComboBoxItem>
                            <ComboBoxItem Tag="Yuna"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Margin="0,0,9,0" Fill="#BED7F1" /><TextBlock Text="Yuna" /></StackPanel></ComboBoxItem>
                            <ComboBoxItem Tag="Lilith"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Margin="0,0,9,0" Fill="#756B96" /><TextBlock Text="Lilith" /></StackPanel></ComboBoxItem>
                            <ComboBoxItem Tag="Chaos"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Margin="0,0,9,0" Fill="#A1A1A1" /><TextBlock Text="Chaos" /></StackPanel></ComboBoxItem>
                        </ComboBox>
                        <Border Height="176" Margin="0,18,0,0" CornerRadius="16"
                                Background="{DynamicResource AeziolSurface}"
                                BorderBrush="{DynamicResource AeziolBorder}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource AeziolRail}" CornerRadius="15,0,0,15">
                                    <Image Width="56" Height="56" Source="{DynamicResource AeziolCicadaDrawing}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="20" VerticalAlignment="Center">
                                    <TextBlock Text="AEZIOL" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource AeziolGoldBright}" />
                                    <TextBlock x:Name="PalettePreviewText" Margin="0,7,0,0" FontSize="11"
                                               Foreground="{DynamicResource AeziolMuted}" />
                                    <StackPanel Margin="0,15,0,0" Orientation="Horizontal">
                                        <Border Width="92" Height="34" CornerRadius="9" Background="{DynamicResource AeziolGold}">
                                            <TextBlock x:Name="PalettePreviewButtonText" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AeziolOnAccent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Ellipse Width="12" Height="12" Margin="14,0,0,0" Fill="{DynamicResource AeziolPrimary}"
                                                 VerticalAlignment="Center" />
                                        <Ellipse Width="12" Height="12" Margin="6,0,0,0" Fill="{DynamicResource AeziolSecondary}"
                                                 VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BackButton" Margin="0,0,8,0" MinWidth="96"
                                Style="{StaticResource ActionButton}" Click="OnBack" />
                        <Button x:Name="FinishButton" MinWidth="132"
                                Style="{StaticResource PrimaryButton}" Click="OnFinish" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
