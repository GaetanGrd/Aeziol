<UserControl x:Class="Aeziol.App.Controls.SettingsSectionCard"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Aeziol.App.Controls"
             xmlns:automation="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             MinHeight="168"
             Background="Transparent"
             Focusable="False">
    <Button x:Name="SectionButton"
            Padding="0"
            Background="{DynamicResource AeziolSurface}"
            BorderBrush="{DynamicResource AeziolTraceBorder}"
            BorderThickness="1"
            Foreground="{DynamicResource AeziolText}"
            Cursor="Hand"
            FocusVisualStyle="{x:Null}"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            automation:AutomationProperties.Name="{Binding Title, ElementName=Root}"
            Click="OnSectionButtonClick"
            MouseEnter="OnCardMouseEnter"
            MouseLeave="OnCardMouseLeave">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="CardSurface"
                        Padding="18,16"
                        CornerRadius="16"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
                <ControlTemplate.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True" />
                            <Condition Property="IsEnabled" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="CardSurface" Property="Background"
                                Value="{DynamicResource AeziolRaised}" />
                        <Setter TargetName="CardSurface" Property="BorderBrush"
                                Value="{DynamicResource AeziolTraceBorderHover}" />
                    </MultiTrigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="CardSurface" Property="Background"
                                Value="{DynamicResource AeziolGoldWash}" />
                        <Setter TargetName="CardSurface" Property="BorderBrush"
                                Value="{DynamicResource AeziolGoldLine}" />
                        <Setter TargetName="CardSurface" Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="CardSurface" Property="BorderBrush"
                                Value="{DynamicResource AeziolGold}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="CardSurface" Property="Opacity" Value="0.38" />
                        <Setter Property="Cursor" Value="Arrow" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:JourneyTrace x:Name="CardJourneyTrace"
                                   Grid.RowSpan="3"
                                   Width="132" Height="58"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   IsHitTestVisible="False"
                                   Orientation="Horizontal"
                                   EdgeFade="0.1"
                                   HighlightFade="0.16"
                                   HighlightRadius="8"
                                   BaseStrokeA="0.9"
                                   BaseStrokeB="0.72"
                                   BaseOpacityA="0.58"
                                   BaseOpacityB="0.3"
                                   HighlightStroke="1.65"
                                   GlowStroke="4.6"
                                   TraceA="M 2,48 C 34,7 76,54 130,10"
                                   TraceB="M 2,51 C 37,13 81,50 130,14">
                <controls:JourneyTrace.Particles>
                    <controls:JourneyParticle X="34" Y="22" Size="2.2" Opacity="0.35"
                                              HighlightSize="3.2" HighlightOpacity="0.9" Tone="Primary" />
                    <controls:JourneyParticle X="84" Y="34" Size="1.6" Opacity="0.32"
                                              HighlightSize="2.6" HighlightOpacity="0.88" Tone="Secondary" />
                    <controls:JourneyParticle X="119" Y="18" Size="2" Opacity="0.38"
                                              HighlightSize="3" HighlightOpacity="0.92" Tone="Primary" />
                </controls:JourneyTrace.Particles>
            </controls:JourneyTrace>

            <Border x:Name="SectionIconSurface"
                    Width="52" Height="52" CornerRadius="16"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource AeziolGoldWash}"
                    BorderBrush="{DynamicResource AeziolGoldLine}"
                    BorderThickness="1">
                <Path Width="28" Height="28"
                      Data="{Binding IconData, ElementName=Root}"
                      Stretch="Uniform"
                      Stroke="{DynamicResource AeziolGold}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
            </Border>

            <StackPanel Grid.Row="1" Margin="0,14,0,12" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource AeziolText}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0"
                           Text="{Binding Description, ElementName=Root}"
                           FontSize="10" LineHeight="14"
                           Foreground="{DynamicResource AeziolDim}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource AeziolBorderSoft}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="0,10,0,0">
                    <TextBlock Text="{Binding ActionText, ElementName=Root}"
                               FontSize="10"
                               Foreground="{DynamicResource AeziolGoldBright}" />
                    <Path Width="6" Height="10" HorizontalAlignment="Right"
                          Data="M 1,1 L 5,5 L 1,9"
                          Stroke="{DynamicResource AeziolGold}" StrokeThickness="1.3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
            </Border>
        </Grid>
    </Button>
</UserControl>
