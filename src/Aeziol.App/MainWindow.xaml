                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Image Width="54" Height="54"
                                                           Source="{DynamicResource AeziolCicadaDrawing}" />
                                                    <TextBlock Margin="0,5,0,0" Text="AEZIOL" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AeziolGoldBright}"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <ToggleButton x:Name="DiscordFallbackToggle"
                                                          Margin="0,14,0,0" Padding="0"
                                                          Background="Transparent" BorderThickness="0"
                                                          Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                <ToggleButton.Content>
                                                    <StackPanel>
                                                        <TextBlock x:Name="DiscordFallbackTitleText"
                                                                   FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock x:Name="DiscordFallbackHintText"
                                                                   Margin="0,3,20,0" FontSize="9"
                                                                   Foreground="{DynamicResource AeziolDim}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </ToggleButton.Content>
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="DisclosureSurface" Padding="12,10" CornerRadius="10"
                                                                Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <ContentPresenter VerticalAlignment="Center" />
                                                                <Path x:Name="DisclosureArrow" Grid.Column="1"
                                                                      Width="11" Height="11" Data="M 2,4 L 6,8 L 10,4"
                                                                      Stretch="Uniform" Stroke="{DynamicResource AeziolMuted}"
                                                                      StrokeThickness="1.4" StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round" VerticalAlignment="Center"
                                                                      RenderTransformOrigin="0.5,0.5">
                                                                    <Path.RenderTransform>
                                                                        <RotateTransform Angle="0" />
                                                                    </Path.RenderTransform>
                                                                </Path>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="DisclosureSurface" Property="Background"
                                                                        Value="{DynamicResource AeziolHover}" />
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="DisclosureSurface" Property="Background"
                                                                        Value="{DynamicResource AeziolGoldWash}" />
                                                                <Setter TargetName="DisclosureArrow" Property="RenderTransform">
                                                                    <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="DisclosureSurface" Property="Background"
                                                                        Value="{DynamicResource AeziolSecondary}" />
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource AeziolOnAccent}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>

                                            <Border x:Name="DiscordFallbackPanel" Margin="0,8,0,0" Padding="14"
                                                    CornerRadius="11" Background="{DynamicResource AeziolRaised}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=DiscordFallbackToggle}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock x:Name="DiscordExecutableLabelText"
                                                               Style="{StaticResource SectionLabel}" />
                                                    <Grid Grid.Row="1" Margin="0,7,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="DiscordExecutablePathTextBox"
                                                                 MinHeight="38"
                                                                 LostKeyboardFocus="OnDiscordExecutablePathLostFocus"
                                                                 KeyDown="OnDiscordExecutablePathKeyDown" />
                                                        <Button x:Name="BrowseDiscordExecutableButton"
                                                                Grid.Column="1" Margin="7,0,0,0"
                                                                MinHeight="38" Padding="12,6"
                                                                Style="{StaticResource ActionButton}"
                                                                Click="OnBrowseDiscordExecutable" />
                                                        <Button x:Name="ClearDiscordExecutableButton"
                                                                Grid.Column="2" Margin="4,0,0,0"
                                                                Width="38" MinHeight="38" Padding="0"
                                                                Style="{StaticResource ActionButton}"
                                                                Content="×" Click="OnClearDiscordExecutable" />
                                                    </Grid>
                                                    <Grid Grid.Row="2" Margin="2,7,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="DiscordExecutableHelpText"
                                                                   Margin="0,0,12,0" FontSize="10"
                                                                   Foreground="{DynamicResource AeziolDim}"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap" />
                                                        <Button x:Name="AutoDetectDiscordExecutableButton"
                                                                 Grid.Column="1" MinHeight="34" Padding="12,5"
                                                                 Style="{StaticResource ActionButton}"
                                                                 Click="OnAutoDetectDiscordExecutable" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="NotificationHost" Grid.RowSpan="2" Width="360" MaxHeight="470"
                          Margin="0,58,18,16" HorizontalAlignment="Right" VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed" Panel.ZIndex="20"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ItemsControl x:Name="NotificationItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type notifications:AppNotification}">
                            <Border x:Name="NotificationCard" Margin="0,0,0,8"
                                    MinHeight="58" CornerRadius="13" ClipToBounds="True"
                                    Background="{DynamicResource AeziolRaised}"
                                    BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="1"
                                    Loaded="OnNotificationCardLoaded">
                                <Border.Resources>
                                    <Style x:Key="NotificationTraceStyle" TargetType="Path">
                                        <Setter Property="Stroke" Value="{DynamicResource AeziolMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static notifications:NotificationSeverity.Success}">
                                                <Setter Property="Stroke" Value="{DynamicResource AeziolSuccess}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static notifications:NotificationSeverity.Warning}">
                                                <Setter Property="Stroke" Value="{DynamicResource AeziolWarningOrange}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static notifications:NotificationSeverity.Error}">
                                                <Setter Property="Stroke" Value="{DynamicResource AeziolDanger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style x:Key="NotificationParticleStyle" TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource AeziolMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static notifications:NotificationSeverity.Success}">
                                                <Setter Property="Fill" Value="{DynamicResource AeziolSuccess}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static notifications:NotificationSeverity.Warning}">
                                                <Setter Property="Fill" Value="{DynamicResource AeziolWarningOrange}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static notifications:NotificationSeverity.Error}">
                                                <Setter Property="Fill" Value="{DynamicResource AeziolDanger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style x:Key="NotificationAuraStyle" TargetType="Rectangle">
                                        <Setter Property="Fill" Value="{DynamicResource AeziolMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static notifications:NotificationSeverity.Success}">
                                                <Setter Property="Fill" Value="{DynamicResource AeziolSuccess}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static notifications:NotificationSeverity.Warning}">
                                                <Setter Property="Fill" Value="{DynamicResource AeziolWarningOrange}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static notifications:NotificationSeverity.Error}">
                                                <Setter Property="Fill" Value="{DynamicResource AeziolDanger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Resources>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>

                                    <Rectangle Width="30" HorizontalAlignment="Left" Opacity="0.055"
                                               Style="{StaticResource NotificationAuraStyle}">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Offset="0" Color="White" />
                                                <GradientStop Offset="1" Color="Transparent" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <Canvas Width="22" Height="46" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Canvas.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Offset="0" Color="Transparent" />
                                                <GradientStop Offset="0.14" Color="White" />
                                                <GradientStop Offset="0.86" Color="White" />
                                                <GradientStop Offset="1" Color="Transparent" />
                                            </LinearGradientBrush>
                                        </Canvas.OpacityMask>
                                        <Path Data="M 8,1 C 3,10 11,17 7,26 C 4,33 9,38 7,45"
                                              Style="{StaticResource NotificationTraceStyle}"
                                              StrokeThickness="1.15" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" Opacity="0.82" />
                                        <Path Data="M 12,2 C 8,11 13,18 10,25 C 7,31 12,37 10,44"
                                              Style="{StaticResource NotificationTraceStyle}"
                                              StrokeThickness="0.75" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" Opacity="0.48" />
                                        <Ellipse Width="3.2" Height="3.2" Canvas.Left="13" Canvas.Top="12"
                                                 Style="{StaticResource NotificationParticleStyle}" Opacity="0.82" />
                                        <Ellipse Width="1.8" Height="1.8" Canvas.Left="5" Canvas.Top="31"
                                                 Style="{StaticResource NotificationParticleStyle}" Opacity="0.54" />
                                    </Canvas>

                                    <TextBlock Grid.Column="1" Margin="8,13,8,13" Text="{Binding Message}"
                                               FontSize="11" LineHeight="16" TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AeziolText}" />
                                    <Button Grid.Column="2" Width="24" Height="24" Margin="0,5,4,0"
                                             Padding="0" Content="×" FontSize="14"
                                             VerticalAlignment="Top" Opacity="0.64"
                                             Style="{StaticResource WindowButton}" Tag="{Binding Id}"
                                             Click="OnDismissNotification" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid x:Name="ModalLayer" Grid.RowSpan="2" Background="#D9090A0C" Visibility="Collapsed"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Width="450" Padding="24" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource AeziolSurface}" BorderBrush="{DynamicResource AeziolBorder}" BorderThickness="1">
                    <StackPanel>
                        <Border Width="46" Height="46" CornerRadius="15" Background="{DynamicResource AeziolGoldWash}"
                                BorderBrush="{DynamicResource AeziolGoldLine}" BorderThickness="1" HorizontalAlignment="Left">
                            <Path Width="23" Height="23" Data="M 12,2 L 22,21 L 2,21 Z M 12,8 L 12,14 M 12,18 L 12,18.2"
                                  Stretch="Uniform" Stroke="{DynamicResource AeziolGold}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" />
                        </Border>
                        <TextBlock x:Name="ModalTitleText" Margin="0,18,0,0" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock x:Name="ModalMessageText" Margin="0,8,0,0" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="ModalTechnicalText" Margin="0,10,0,0" FontSize="10"
                                   Foreground="{DynamicResource AeziolDim}" Visibility="Collapsed" />
                        <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ModalSecondaryButton" Margin="0,0,8,0" Style="{StaticResource QuietButton}"
                                    Click="OnModalSecondary" Visibility="Collapsed" />
                            <Button x:Name="ModalCancelButton" Margin="0,0,8,0" Style="{StaticResource QuietButton}"
                                    Click="OnModalCancel" />
                            <Button x:Name="ModalConfirmButton" Style="{StaticResource PrimaryButton}"
                                    Click="OnModalConfirm" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="AuthorizationLayer" Grid.RowSpan="2" Background="#E6090A0C" Visibility="Collapsed"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Width="430" Padding="26" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource AeziolSurface}" BorderBrush="{DynamicResource AeziolBorder}" BorderThickness="1">
                    <StackPanel>
                        <Border Width="48" Height="48" CornerRadius="15" HorizontalAlignment="Left"
                                Background="{DynamicResource AeziolRaised}" BorderBrush="{DynamicResource AeziolBorderSoft}"
                                BorderThickness="1">
                            <Path Width="25" Height="19" Stretch="Uniform"
                                  Data="{StaticResource DiscordSymbolGeometry}" Fill="#5865F2" />
                        </Border>
                        <TextBlock x:Name="AuthorizationWaitingTitleText" Margin="0,18,0,0"
                                   FontSize="21" FontWeight="SemiBold" />
                        <TextBlock x:Name="AuthorizationWaitingMessageText" Margin="0,8,0,0"
                                   Style="{StaticResource PageSubtitle}" />
                        <Border Margin="0,18,0,0" Padding="13,10" CornerRadius="11"
                                Background="{DynamicResource AeziolRaised}"
                                BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AuthorizationWaitingHintText" FontSize="11"
                                           Foreground="{DynamicResource AeziolMuted}" />
                                <TextBlock x:Name="AuthorizationElapsedText" Grid.Column="1" Margin="18,0,0,0"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AeziolGold}" />
                            </Grid>
                        </Border>
                        <Button x:Name="CancelAuthorizationButton" Margin="0,22,0,0" HorizontalAlignment="Right"
                                Style="{StaticResource QuietButton}" Click="OnCancelAuthorization" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="AboutLayer" Grid.RowSpan="2" Background="#E6090A0C" Visibility="Collapsed"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  MouseLeftButtonDown="OnAboutBackdropClick">
                <Border x:Name="AboutDialog" Width="470" MaxHeight="600" Margin="16" Padding="28" CornerRadius="22"
                        HorizontalAlignment="Center" VerticalAlignment="Stretch"
                        Background="{DynamicResource AeziolSurface}" BorderBrush="{DynamicResource AeziolBorder}" BorderThickness="1"
                        MouseLeftButtonDown="OnAboutDialogClick">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly">
                            <StackPanel Margin="0,0,8,0">
                                <Grid>
                                    <Image Width="68" Height="46" HorizontalAlignment="Left" Stretch="Uniform"
                                           Source="{DynamicResource AeziolCicadaDrawing}" />
                                    <Button x:Name="AboutCloseButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Style="{StaticResource WindowButton}" Content="×" Click="OnCloseAbout" />
                                </Grid>

                                <TextBlock x:Name="AboutTitleText" Margin="0,18,0,0" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock x:Name="AboutSubtitleText" Margin="0,6,0,0" Style="{StaticResource PageSubtitle}" />
                                <TextBlock x:Name="AboutVersionText" Margin="0,8,0,0" FontSize="10"
                                           Foreground="{DynamicResource AeziolDim}" />

                                <Border Margin="0,22,0,0" Padding="18" CornerRadius="15"
                                        Background="{DynamicResource AeziolRaised}"
                                        BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="1">
                                    <StackPanel>
                                <TextBlock x:Name="AboutAuthorLabelText" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="AboutAuthorText" Margin="0,5,0,0" FontSize="15" FontWeight="SemiBold" />
                                <Border Margin="0,16,0,16" BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="0,1,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="6" Height="6" Margin="0,6,0,0" VerticalAlignment="Top"
                                             Fill="{DynamicResource AeziolGold}" />
                                    <TextBlock x:Name="AboutAiText" Grid.Column="1" FontSize="12"
                                               Foreground="{DynamicResource AeziolMuted}" LineHeight="18" />
                                </Grid>
                                <Border Margin="0,16,0,14" BorderBrush="{DynamicResource AeziolBorderSoft}"
                                        BorderThickness="0,1,0,0" />
                                <TextBlock x:Name="AboutMusicSectionLabelText" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="AboutMusicPurposeText" Margin="0,5,0,0" FontSize="11"
                                           Foreground="{DynamicResource AeziolMuted}" TextWrapping="Wrap" LineHeight="16" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Style="{StaticResource MusicArtwork}">
                                        <MediaElement x:Name="AboutMusicAnimatedCover" Stretch="UniformToFill"
                                                      Visibility="Collapsed" IsMuted="True"
                                                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                      MediaEnded="OnAboutMusicCoverEnded"
                                                      MediaFailed="OnAboutMusicCoverFailed" />
                                        <Image x:Name="AboutMusicStaticCover" Stretch="UniformToFill"
                                               Source="/Aeziol.App;component/Assets/Audio/onde-doree-cover.png" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="AboutMusicTitleText" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock x:Name="AboutMusicCreditText" Margin="0,4,0,0" FontSize="10"
                                                   Foreground="{DynamicResource AeziolDim}" LineHeight="15" />
                                    </StackPanel>
                                </Grid>
                                <Border Margin="0,16,0,14" BorderBrush="{DynamicResource AeziolBorderSoft}"
                                        BorderThickness="0,1,0,0" />
                                <Grid Opacity="0.78">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Style="{StaticResource AboutWorldLogo}">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="/Aeziol.App;component/Assets/Brand/elgo-logo-square.png"
                                                        Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock x:Name="AboutElgoText" Grid.Column="1" Margin="10,0,0,0"
                                               FontSize="11" Foreground="{DynamicResource AeziolDim}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="AboutLoreText" Margin="0,14,0,0" FontSize="10"
                                           FontStyle="Italic" Foreground="{DynamicResource AeziolDim}"
                                           TextWrapping="Wrap" LineHeight="15" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="AboutDismissButton" Margin="0,0,8,0" Style="{StaticResource QuietButton}"
                                    Click="OnCloseAbout" />
                            <Button x:Name="AboutGitHubButton" Style="{StaticResource PrimaryButton}"
                                    Click="OnOpenProject" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </Viewbox>
    </Border>
</Window>
