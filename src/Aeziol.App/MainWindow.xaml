<Window x:Class="Aeziol.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:notifications="clr-namespace:Aeziol.App.Notifications"
        xmlns:controls="clr-namespace:Aeziol.App.Controls"
        Title="Aeziol"
        Width="900" Height="620" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource AeziolCanvas}"
        UseLayoutRounding="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="7"
                            CornerRadius="14" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" Background="{DynamicResource AeziolCanvas}"
            BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="1"
            CornerRadius="14">
        <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid x:Name="ResponsiveSurface" Width="900" Height="620">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource AeziolRail}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="0,0,1,0" />
                <StackPanel Grid.Column="1" Margin="17,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AEZIOL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AeziolGoldBright}" />
                    <Border Width="1" Height="14" Margin="12,0" Background="{DynamicResource AeziolBorder}" />
                    <TextBlock x:Name="WindowContextText" FontSize="11" Foreground="{DynamicResource AeziolDim}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="6" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="AmbientMusicMuteButton" Margin="1,0" Style="{StaticResource WindowButton}"
                            Click="OnToggleAmbientMusicMute">
                        <Grid Width="16" Height="16">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 2,6 L 6,6 L 10,3 L 10,13 L 6,10 L 2,10 Z M 12,6 C 13.5,7 13.5,9 12,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path x:Name="AmbientMusicMutedGlyph" Width="8" Height="8" Margin="8,0,0,0"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                  Data="M 1,1 L 7,7 M 7,1 L 1,7"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </Button>
                    <Button x:Name="AboutButton" Margin="1,0" Style="{StaticResource WindowButton}" Content="?"
                            FontSize="13" FontWeight="SemiBold" Click="OnOpenAbout" />
                    <Button x:Name="MinimizeButton" Margin="1,0" Style="{StaticResource WindowButton}" Content="-" FontSize="20"
                            Click="OnMinimizeWindow" />
                    <Button x:Name="MaximizeButton" Margin="1,0" Style="{StaticResource WindowButton}" Click="OnToggleMaximizeWindow">
                        <Grid Width="14" Height="14">
                            <Path x:Name="MaximizeGlyph" Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 1,1 L 13,1 L 13,13 L 1,13 Z" Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.35" SnapsToDevicePixels="True" />
                            <Path x:Name="RestoreGlyph" Width="13" Height="13" Stretch="Uniform" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 4,1 L 13,1 L 13,10 M 1,4 L 10,4 L 10,13 L 1,13 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.25" SnapsToDevicePixels="True" />
                        </Grid>
                    </Button>
                    <Button x:Name="CloseWindowButton" Margin="1,0" Style="{StaticResource WindowButton}" Content="×" Click="OnCloseWindow">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="CloseActionsMenu" Width="238" Padding="4"
                                         Placement="Custom"
                                         Background="{DynamicResource AeziolRaised}"
                                         BorderBrush="{DynamicResource AeziolBorder}" BorderThickness="1"
                                         HasDropShadow="True">
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Padding="{TemplateBinding Padding}" CornerRadius="10"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </Border>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Foreground" Value="{DynamicResource AeziolText}" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="MenuChrome" Padding="12,9" CornerRadius="8"
                                                            Background="Transparent">
                                                        <ContentPresenter ContentSource="Header" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="MenuChrome" Property="Background"
                                                                    Value="{DynamicResource AeziolHover}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem x:Name="CloseHideMenuItem" Foreground="{DynamicResource AeziolWarningOrange}"
                                          Click="OnHideFromCloseMenu">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14" Margin="0,0,9,0" Stretch="Uniform"
                                                  Data="M 2,7 L 12,7 M 4,10 L 10,10"
                                                  Stroke="{DynamicResource AeziolWarningOrange}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <TextBlock x:Name="CloseHideMenuText" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AeziolWarningOrange}" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="CloseQuitMenuItem" Foreground="{DynamicResource AeziolDanger}"
                                          Click="OnQuitFromCloseMenu">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14" Margin="0,0,9,0" Stretch="Uniform"
                                                  Data="M 7,1 L 7,7 M 3.5,3.5 C 0.5,6.5 2,13 7,13 C 12,13 13.5,6.5 10.5,3.5"
                                                  Stroke="{DynamicResource AeziolDanger}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <TextBlock x:Name="CloseQuitMenuText" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AeziolDanger}" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator Margin="8,4" Background="{DynamicResource AeziolBorderSoft}" />
                                <MenuItem x:Name="CloseRememberMenuItem" IsCheckable="True"
                                          StaysOpenOnClick="True">
                                    <MenuItem.Header>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="21" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="14" Height="14" HorizontalAlignment="Left"
                                                    VerticalAlignment="Top" Margin="0,1,0,0"
                                                    CornerRadius="3" BorderThickness="1"
                                                    BorderBrush="{DynamicResource AeziolMuted}">
                                                <Path Width="9" Height="7" Stretch="Uniform"
                                                      Data="M 1,4 L 3.5,6.5 L 8,1"
                                                      Stroke="{DynamicResource AeziolGoldBright}"
                                                      StrokeThickness="1.7" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="CloseRememberMenuText" FontSize="11"
                                                           FontWeight="SemiBold" />
                                                <TextBlock x:Name="CloseRememberMenuNoteText" Margin="0,3,0,0"
                                                           MaxWidth="185" FontSize="9"
                                                           Foreground="{DynamicResource AeziolDim}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,-46,0,0" Background="{DynamicResource AeziolRail}"
                        BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Height="62" Margin="10,3" IsHitTestVisible="False">
                            <Image Width="52" Height="52" Stretch="Uniform"
                                   Source="{DynamicResource AeziolCicadaDrawing}" />
                        </Grid>

                        <Border Grid.Row="1" Margin="18,6,18,7"
                                BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="0,1,0,0" />

                        <Border x:Name="PassageCategoryHeader" Grid.Row="2" Margin="12,8,12,4" Padding="3,0,3,8"
                                BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="0,0,0,1"
                                IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Width="16" Height="13" Stretch="Uniform"
                                      Data="M 1,13 C 6,3 13,3 18,13 M 18,13 L 22,9 M 18,13 L 22,17"
                                      Stroke="{DynamicResource AeziolDim}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <TextBlock x:Name="PassageHeaderText" Margin="5,0,0,0" FontSize="10"
                                           Foreground="{DynamicResource AeziolMuted}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <RadioButton x:Name="DiscordNav" Grid.Row="3" Style="{StaticResource NavRadio}"
                                     IsChecked="True" Checked="OnNavigateDiscord">
                            <StackPanel>
                                <Path Width="23" Height="18" Stretch="Uniform"
                                      Data="{StaticResource DiscordSymbolGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock x:Name="DiscordNavText" Margin="0,5,0,0" FontSize="9"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ComingSoonNav" Grid.Row="4" Style="{StaticResource NavRadio}"
                                     IsEnabled="False" IsTabStop="False">
                            <StackPanel>
                                <Path Width="22" Height="18" Stretch="Uniform"
                                      Data="M 3,9 L 5,9 M 10,9 L 12,9 M 17,9 L 19,9"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <TextBlock x:Name="ComingSoonNavText" Margin="0,5,0,0" FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <Grid x:Name="SettingsNavSection" Grid.Row="6" VerticalAlignment="Bottom">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Margin="18,0,18,5" BorderBrush="{DynamicResource AeziolBorderSoft}"
                                    BorderThickness="0,1,0,0" />
                            <RadioButton x:Name="SettingsNav" Grid.Row="1" Style="{StaticResource NavRadio}"
                                         Checked="OnNavigateSettings">
                                <StackPanel>
                                    <Path Width="21" Height="21" Stretch="Uniform" SnapsToDevicePixels="True"
                                          Data="{StaticResource SettingsRingsGeometry}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7" />
                                    <TextBlock x:Name="SettingsNavText" Margin="0,4,0,0" FontSize="9"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <Border Grid.Row="7" Margin="18,0,18,18" Padding="0,10,0,0"
                                BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="0,1,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse x:Name="RailStatusDot" Width="7" Height="7" Fill="{DynamicResource AeziolDim}" />
                                <TextBlock x:Name="RailStatusText" Margin="0,5,0,0" MaxWidth="54"
                                           FontSize="8" Foreground="{DynamicResource AeziolDim}"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid x:Name="PageHost" Grid.Column="1" Margin="30,24,30,28">
                    <Grid x:Name="DiscordView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70" />
                            <RowDefinition Height="46" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="DiscordHeading" Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DiscordTitleText" Style="{StaticResource PageTitle}" />
                                <Button x:Name="AutomationActionButton" Margin="12,1,0,0"
                                        MinWidth="88" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Style="{StaticResource AutomationHeaderButton}"
                                        Click="OnAutomationAction">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="AutomationActionIcon" Width="10" Height="10" Margin="0,0,6,0"
                                              Stretch="Uniform" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock x:Name="AutomationActionText" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="DiscordSubtitleText" Grid.Row="1" Margin="0,5,0,0"
                                       Style="{StaticResource PageSubtitle}" />
                        </Grid>

                        <Border Grid.Row="1" Margin="0,0,0,7"
                                BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="DiscordOverviewTab" GroupName="DiscordSections"
                                             Style="{StaticResource SettingsSectionTab}" IsChecked="True"
                                             Checked="OnDiscordSectionChanged" />
                                <RadioButton x:Name="DiscordRulesTab" GroupName="DiscordSections"
                                             Style="{StaticResource SettingsSectionTab}"
                                             Checked="OnDiscordSectionChanged" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2">
                        <Border x:Name="PassageAutomationContent" CornerRadius="24"
                                BorderBrush="{DynamicResource AeziolTraceBorder}" BorderThickness="1">
                            <Border.Background>
                                <RadialGradientBrush Center="0.52,0.48" GradientOrigin="0.52,0.48" RadiusX="0.72" RadiusY="0.9">
                                    <GradientStop Color="{DynamicResource AeziolGoldWashColor}" Offset="0" />
                                    <GradientStop Color="{DynamicResource AeziolRouteMidColor}" Offset="0.52" />
                                    <GradientStop Color="{DynamicResource AeziolRouteEdgeColor}" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                            <Grid Margin="24,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border x:Name="VoicePill" HorizontalAlignment="Left" Padding="10,6" CornerRadius="12"
                                        Background="{DynamicResource AeziolRaised}" BorderBrush="{DynamicResource AeziolBorder}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="VoicePillDot" Width="7" Height="7" Margin="0,0,8,0"
                                                 Fill="{DynamicResource AeziolDim}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="VoicePillText" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="4,12,4,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="250" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                MouseEnter="OnPassageJourneySourceEnter"
                                                MouseLeave="OnPassageJourneyLeave">
                                        <TextBlock x:Name="SourceLabelText" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                                        <Border Width="86" Height="86" Margin="0,10,0,0" CornerRadius="43"
                                                Background="{DynamicResource AeziolRaised}"
                                                BorderBrush="{DynamicResource AeziolBorder}" BorderThickness="1"
                                                HorizontalAlignment="Center">
                                            <Grid>
                                                <Path Width="39" Height="29" Stretch="Uniform"
                                                      Data="{StaticResource DiscordSymbolGeometry}"
                                                      Fill="#5865F2" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="Discord" Margin="0,9,0,0" FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock x:Name="DiscordSourceStateText" Margin="0,3,0,0" FontSize="10"
                                                   Foreground="{DynamicResource AeziolDim}" TextAlignment="Center" />
                                        <Button x:Name="PassageDiscordActionButton" Margin="0,9,0,0"
                                                MinHeight="30" Padding="11,4" FontSize="10"
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="OnPassageDiscordAction" />
                                    </StackPanel>

                                    <Grid Grid.Column="1" Margin="10,0">
                                        <Viewbox Height="62" Stretch="Fill" VerticalAlignment="Center"
                                                 IsHitTestVisible="False">
                                            <controls:JourneyTrace x:Name="PassageJourneyTrace"
                                                                   Width="200" Height="62"
                                                                   Orientation="Horizontal"
                                                                   EdgeFade="0.06" HighlightFade="0.14" HighlightRadius="12"
                                                                   BaseStrokeA="1.2" BaseStrokeB="0.9"
                                                                   BaseOpacityA="1" BaseOpacityB="0.44"
                                                                   HighlightStroke="1.7" GlowStroke="5"
                                                                   TraceA="M 0,35 C 22,8 48,7 75,26 C 88,35 94,39 103,38 C 130,59 166,58 200,31"
                                                                   TraceB="M 0,31 C 23,12 49,11 76,28 C 88,36 96,36 104,35 C 131,55 165,54 200,35">
                                                <controls:JourneyTrace.Particles>
                                                    <controls:JourneyParticle X="41" Y="13" Size="2.5" Opacity="0.48"
                                                                              HighlightSize="3.5" HighlightOpacity="0.94" Tone="Primary" />
                                                    <controls:JourneyParticle X="78" Y="28" Size="1.7" Opacity="0.42"
                                                                              HighlightSize="2.5" HighlightOpacity="0.9" Tone="Secondary" />
                                                    <controls:JourneyParticle X="130" Y="49" Size="2" Opacity="0.44"
                                                                              HighlightSize="3" HighlightOpacity="0.9" Tone="Primary" />
                                                    <controls:JourneyParticle X="166" Y="48" Size="1.5" Opacity="0.4"
                                                                              HighlightSize="2.5" HighlightOpacity="0.88" Tone="Secondary" />
                                                </controls:JourneyTrace.Particles>
                                            </controls:JourneyTrace>
                                        </Viewbox>
                                        <Border Width="82" Height="82" CornerRadius="23" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="{DynamicResource AeziolRaised}" BorderBrush="{DynamicResource AeziolGoldLine}" BorderThickness="1">
                                            <Image Width="54" Height="54"
                                                   Source="{DynamicResource AeziolCicadaDrawing}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                MouseEnter="OnPassageJourneyTargetEnter"
                                                MouseLeave="OnPassageJourneyLeave">
                                        <TextBlock x:Name="TargetLabelText" Style="{StaticResource SectionLabel}" />
                                        <Grid Margin="0,9,0,0">
                                            <ComboBox x:Name="PassageDestinationCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      SelectionChanged="OnDestinationChanged"
                                                      FlowDirection="LeftToRight" />
                                            <TextBlock x:Name="PassageDestinationPlaceholderText"
                                                       Margin="13,0,36,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AeziolMuted}"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=PassageDestinationCombo}"
                                                                         Value="-1">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock x:Name="TargetHelpText" Margin="2,7,0,0" Style="{StaticResource BodyMuted}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="2" Padding="14,11" CornerRadius="12"
                                        Background="{DynamicResource AeziolSurface}" BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="CurrentOutputLabelText" Style="{StaticResource SectionLabel}" />
                                        <ComboBox x:Name="CurrentOutputCombo" Margin="-6,2,0,-3" MinHeight="30"
                                                  Padding="6,2" Background="Transparent" BorderBrush="Transparent"
                                                  MaxWidth="320"
                                                  Style="{StaticResource CompactComboBox}" SelectedValuePath="Id"
                                                  SelectionChanged="OnCurrentOutputChanged"
                                                  FlowDirection="LeftToRight">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock x:Name="RestoreOutputText" Margin="0,6,0,0" FontSize="12"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   Visibility="Collapsed" />
                                        <Button x:Name="ForceRestoreButton" Margin="0,8,0,0" Padding="10,5"
                                                MinHeight="30" HorizontalAlignment="Left" FontSize="10"
                                                Style="{StaticResource ActionButton}" Visibility="Collapsed"
                                                Click="OnForceRestore" />
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </Border>

                    <Grid x:Name="RulesView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="RulesTitleText" Style="{StaticResource PageTitle}" />
                            <TextBlock x:Name="RulesSubtitleText" Margin="0,5,0,0" Style="{StaticResource PageSubtitle}" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                            <StackPanel Margin="0,0,8,2">
                                <Grid Height="390">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="1.25*" />
