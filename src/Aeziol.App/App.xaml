        <Style x:Key="LanguageChoiceList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LanguageChoiceCard" DataType="{x:Type localization:LanguageCardOption}">
            <Border x:Name="LanguageCardChrome" MinHeight="50" Padding="11,8" CornerRadius="11"
                    Background="{DynamicResource AeziolRaised}"
                    BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource AeziolMuted}" StrokeThickness="1.5" />
                        <Ellipse x:Name="LanguageSelectedDot" Width="8" Height="8"
                                 Fill="{DynamicResource AeziolPrimary}" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NativeName}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DisplayName}" Margin="0,2,0,0" FontSize="9"
                                   Foreground="{DynamicResource AeziolDim}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Width="36" Height="25" CornerRadius="5"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            ClipToBounds="True" BorderBrush="{DynamicResource AeziolBorderSoft}" BorderThickness="1">
                        <Image Source="{Binding FlagSource}" Stretch="UniformToFill" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <Setter TargetName="LanguageCardChrome" Property="Background" Value="{DynamicResource AeziolHover}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <Setter TargetName="LanguageCardChrome" Property="Background" Value="{DynamicResource AeziolGoldWash}" />
                    <Setter TargetName="LanguageCardChrome" Property="BorderBrush" Value="{DynamicResource AeziolGoldLine}" />
                    <Setter TargetName="LanguageSelectedDot" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="LanguageChoiceCompact" DataType="{x:Type localization:LanguageCardOption}">
            <Grid MinHeight="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="19" CornerRadius="4"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        ClipToBounds="True" BorderBrush="{DynamicResource AeziolBorderSoft}"
                        BorderThickness="1">
                    <Image Source="{Binding FlagSource}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NativeName}" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DisplayName}" Margin="0,1,0,0" FontSize="8"
                               Foreground="{DynamicResource AeziolDim}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="DeviceCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource AeziolText}" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="Click" Handler="OnDeviceCheckClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Padding="12,9" CornerRadius="9" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Width="16" Height="16" CornerRadius="5"
                                        BorderBrush="{DynamicResource AeziolBorder}" BorderThickness="1"
                                        Background="{DynamicResource AeziolRaised}">
                                    <Path x:Name="Tick" Data="M 3,8 L 7,12 L 14,4"
                                          Stroke="{DynamicResource AeziolOnAccent}" StrokeThickness="2"
                                          Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform x:Name="TickScale" ScaleX="0.65" ScaleY="0.65" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AeziolHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AeziolGold}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AeziolGold}" />
                                <Setter TargetName="Tick" Property="Opacity" Value="1" />
                                <Setter TargetName="Tick" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource AeziolRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource AeziolText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AeziolBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
        </Style>
    </Application.Resources>
</Application>
