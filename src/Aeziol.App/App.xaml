            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Foreground" Value="{DynamicResource AeziolText}" />
            <Setter Property="Background" Value="{DynamicResource AeziolRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AeziolBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource AeziolGold}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AeziolGoldLine}" />
            <Setter Property="FontSize" Value="12" />
