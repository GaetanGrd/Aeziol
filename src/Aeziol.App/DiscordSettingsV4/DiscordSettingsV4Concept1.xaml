<UserControl x:Class="Aeziol.App.DiscordSettingsV4.DiscordSettingsV4Concept1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="760" d:DesignWidth="1040"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="DiscordSettingsCard" TargetType="Border">
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{DynamicResource AeziolSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AeziolBorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DiscordPreferenceRow" TargetType="Border">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Padding" Value="2,13" />
            <Setter Property="BorderBrush" Value="{DynamicResource AeziolBorderSoft}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="DiscordLastPreferenceRow" TargetType="Border"
               BasedOn="{StaticResource DiscordPreferenceRow}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,13,2,2" />
        </Style>

        <Style x:Key="DiscordSettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AeziolText}" />
        </Style>

        <Style x:Key="DiscordSettingHelp" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="LineHeight" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource AeziolDim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AeziolCanvas}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="900" Margin="48,40,48,52"
                  HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="2,0,2,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" Margin="0,1,14,0"
                            CornerRadius="11"
                            Background="{DynamicResource AeziolGoldWash}"
                            BorderBrush="{DynamicResource AeziolGoldLine}"
                            BorderThickness="1">
                        <Path Width="20" Height="20"
                              Data="{DynamicResource SettingsRingsGeometry}"
                              Stretch="Uniform"
                              Stroke="{DynamicResource AeziolGold}"
                              StrokeThickness="1.5" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Réglages Discord"
                                   Style="{StaticResource PageTitle}" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="Choisissez comment Aeziol se comporte autour de vos sorties audio."
                                   Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource DiscordSettingsCard}">
                    <StackPanel>
                        <TextBlock Text="PRÉFÉRENCES AUDIO"
                                   Style="{StaticResource SectionLabel}" />

                        <Border x:Name="RestoreDelaySetting"
                                Tag="DiscordSettingsV4:RestoreDelay"
                                Margin="0,7,0,0"
                                Style="{StaticResource DiscordPreferenceRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Text="Délai avant restauration de la sortie"
                                               Style="{StaticResource DiscordSettingTitle}" />
                                    <TextBlock Text="Laissez quelques secondes aux applications pour terminer leur transition audio."
                                               Style="{StaticResource DiscordSettingHelp}" />
                                </StackPanel>
                                <ComboBox x:Name="RestoreDelayComboBox"
                                          Grid.Column="1" Width="176"
                                          VerticalAlignment="Center"
                                          SelectedIndex="2">
                                    <ComboBoxItem Content="Immédiatement" />
                                    <ComboBoxItem Content="Après 3 secondes" />
                                    <ComboBoxItem Content="Après 5 secondes" />
                                    <ComboBoxItem Content="Après 10 secondes" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border x:Name="ProtectedOutputsSetting"
                                Tag="DiscordSettingsV4:ProtectedOutputs"
                                Style="{StaticResource DiscordPreferenceRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Text="Sorties à ne jamais modifier"
                                               Style="{StaticResource DiscordSettingTitle}" />
                                    <TextBlock Text="Gardez vos appareils sensibles en dehors des changements automatiques."
                                               Style="{StaticResource DiscordSettingHelp}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Aucune sortie exclue"
                                               Margin="0,0,0,7"
                                               HorizontalAlignment="Right"
                                               FontSize="10"
                                               Foreground="{DynamicResource AeziolMuted}" />
                                    <Button x:Name="ManageProtectedOutputsButton"
                                            Content="Gérer la liste"
                                            Style="{StaticResource ActionButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="WindowsNotificationSetting"
                                Tag="DiscordSettingsV4:WindowsNotification"
                                Style="{StaticResource DiscordLastPreferenceRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Text="Envoyer une notification Windows"
                                               Style="{StaticResource DiscordSettingTitle}" />
                                    <TextBlock Text="Lorsqu’Aeziol change une sortie audio."
                                               Style="{StaticResource DiscordSettingHelp}" />
                                </StackPanel>
                                <CheckBox x:Name="WindowsNotificationToggle"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsChecked="True"
                                          Style="{StaticResource ToggleSwitch}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Margin="0,16,0,0"
                        Style="{StaticResource DiscordSettingsCard}">
                    <StackPanel>
                        <TextBlock Text="DÉPANNAGE"
                                   Style="{StaticResource SectionLabel}" />

                        <Border x:Name="ManualDiscordExecutableSetting"
                                Tag="DiscordSettingsV4:ManualDiscordExecutable"
                                Margin="0,7,0,0"
                                Style="{StaticResource DiscordLastPreferenceRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Text="Configurer manuellement Discord.exe"
                                               Style="{StaticResource DiscordSettingTitle}" />
                                    <TextBlock Text="Aeziol recherche normalement le fichier tout seul. Indiquez-le uniquement si la détection automatique ne suffit pas."
                                               Style="{StaticResource DiscordSettingHelp}" />
                                    <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,7,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource AeziolSuccess}" />
                                        <TextBlock Text="Détection automatique utilisée"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AeziolMuted}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="ChooseDiscordExecutableButton"
                                        Grid.Column="1"
                                        Content="Choisir Discord.exe"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ActionButton}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Margin="0,16,0,0"
                        Style="{StaticResource DiscordSettingsCard}">
                    <StackPanel>
                        <TextBlock Text="SÉCURITÉ"
                                   Style="{StaticResource SectionLabel}" />

                        <Border x:Name="RevokeDiscordAuthorizationSetting"
                                Tag="DiscordSettingsV4:RevokeAuthorization"
                                Margin="0,7,0,0"
                                Style="{StaticResource DiscordLastPreferenceRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Text="Révoquer l’autorisation Discord"
                                               Style="{StaticResource DiscordSettingTitle}" />
                                    <TextBlock Text="Retirez l’accès à Discord déjà accordé à Aeziol."
                                               Style="{StaticResource DiscordSettingHelp}" />
                                </StackPanel>
                                <Button x:Name="RevokeDiscordAuthorizationButton"
                                        Grid.Column="1"
                                        Content="Révoquer"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DangerButton}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
