<UserControl x:Class="Aeziol.App.DiscordSettingsV4.DiscordSettingsV4Concept3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             MinWidth="600" MinHeight="640"
             Background="{DynamicResource AeziolCanvas}"
             Foreground="{DynamicResource AeziolText}">
    <UserControl.Resources>
        <Style x:Key="ConceptCard" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{DynamicResource AeziolSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AeziolBorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ConceptSettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AeziolText}" />
        </Style>

        <Style x:Key="ConceptSettingDescription" TargetType="TextBlock"
               BasedOn="{StaticResource BodyMuted}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="MaxWidth" Value="470" />
        </Style>

        <Style x:Key="ConceptDividerRow" TargetType="Border">
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="BorderBrush" Value="{DynamicResource AeziolBorderSoft}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="ConceptExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource AeziolText}" />
            <Setter Property="Background" Value="{DynamicResource AeziolSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AeziolBorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border x:Name="OuterBorder"
                                CornerRadius="13"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel>
                                <ToggleButton x:Name="HeaderButton"
                                              Padding="18,15"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontSize="13"
                                              FontWeight="SemiBold"
                                              HorizontalContentAlignment="Stretch"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              automation:AutomationProperties.Name="{TemplateBinding Header}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderSurface"
                                                    Padding="{TemplateBinding Padding}"
                                                    CornerRadius="12"
                                                    Background="{TemplateBinding Background}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                                    <Path x:Name="Chevron" Grid.Column="1"
                                                          Width="10" Height="6" Margin="16,0,1,0"
                                                          Data="M 1,1 L 5,5 L 9,1"
                                                          Stretch="Fill"
                                                          Stroke="{DynamicResource AeziolMuted}"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderSurface" Property="Background"
                                                            Value="{DynamicResource AeziolHover}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="HeaderSurface" Property="BorderBrush"
                                                            Value="{DynamicResource AeziolGoldLine}" />
                                                    <Setter TargetName="HeaderSurface" Property="BorderThickness" Value="1" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter Content="{TemplateBinding Header}" />
                                </ToggleButton>
                                <Border x:Name="ExpandedContent"
                                        Padding="18,0,18,18"
                                        Visibility="Collapsed">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,28,32,36" HorizontalAlignment="Center" MaxWidth="760">
            <StackPanel>
                <TextBlock Text="Réglages Discord" Style="{StaticResource PageTitle}" />
                <TextBlock Margin="0,7,0,0"
                           Text="Ajustez uniquement le comportement audio lié à Discord et les options de dépannage."
                           Style="{StaticResource PageSubtitle}" />

                <TextBlock Margin="2,28,0,9"
                           Text="PRÉFÉRENCES AUDIO"
                           Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource ConceptCard}">
                    <StackPanel>
                        <Border Tag="2" Style="{StaticResource ConceptDividerRow}" Padding="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Délai avant restauration"
                                               Style="{StaticResource ConceptSettingTitle}" />
                                    <TextBlock Text="Temps d’attente avant de rétablir vos réglages audio."
                                               Style="{StaticResource ConceptSettingDescription}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="118" VerticalAlignment="Center"
                                          SelectedIndex="1"
                                          automation:AutomationProperties.Name="Délai avant restauration">
                                    <ComboBoxItem Content="Immédiat" />
                                    <ComboBoxItem Content="1 seconde" />
                                    <ComboBoxItem Content="3 secondes" />
                                    <ComboBoxItem Content="5 secondes" />
                                    <ComboBoxItem Content="10 secondes" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Tag="9" Padding="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Notification Windows"
                                               Style="{StaticResource ConceptSettingTitle}" />
                                    <TextBlock Text="Afficher une notification quand Aeziol modifie une sortie audio."
                                               Style="{StaticResource ConceptSettingDescription}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                          IsChecked="True"
                                          Style="{StaticResource ToggleSwitch}"
                                          automation:AutomationProperties.Name="Notification Windows lors d’un changement de sortie" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Expander Tag="3" Margin="0,10,0,0"
                          Header="Sorties à ne jamais modifier"
                          Style="{StaticResource ConceptExpander}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,10"
                                   Text="Aeziol laissera ces sorties intactes."
                                   Style="{StaticResource BodyMuted}" />
                        <CheckBox Margin="0,4" Padding="0,5"
                                  Content="Écran du salon"
                                  IsChecked="True"
                                  Style="{StaticResource DeviceCheck}" />
                        <CheckBox Margin="0,4" Padding="0,5"
                                  Content="Casque USB de travail"
                                  Style="{StaticResource DeviceCheck}" />
                        <CheckBox Margin="0,4" Padding="0,5"
                                  Content="Enceintes du bureau"
                                  Style="{StaticResource DeviceCheck}" />
                    </StackPanel>
                </Expander>

                <TextBlock Margin="2,26,0,9"
                           Text="DÉPANNAGE"
                           Style="{StaticResource SectionLabel}" />
                <Expander Tag="8"
                          Header="Emplacement de Discord.exe"
                          Style="{StaticResource ConceptExpander}">
                    <StackPanel>
                        <TextBlock Text="Discord.exe est détecté automatiquement. Indiquez un chemin seulement si cette détection ne fonctionne pas."
                                   Style="{StaticResource BodyMuted}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox MinHeight="38"
                                     VerticalContentAlignment="Center"
                                     Text="C:\Users\vous\AppData\Local\Discord\app-1.0.0\Discord.exe"
                                     automation:AutomationProperties.Name="Chemin personnalisé vers Discord.exe" />
                            <Button Grid.Column="1" Margin="8,0,0,0"
                                    MinHeight="38" Padding="13,7"
                                    Content="Parcourir..."
                                    Style="{StaticResource ActionButton}" />
                        </Grid>
                        <TextBlock Margin="2,8,0,0"
                                   Text="Sans chemin personnalisé, la détection automatique reste utilisée."
                                   FontSize="10"
                                   Foreground="{DynamicResource AeziolDim}" />
                    </StackPanel>
                </Expander>

                <TextBlock Margin="2,26,0,9"
                           Text="SÉCURITÉ"
                           Style="{StaticResource SectionLabel}" />
                <Expander Tag="7"
                          Header="Autorisation Discord"
                          Style="{StaticResource ConceptExpander}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,24,0"
                                   VerticalAlignment="Center"
                                   Text="Retire à Aeziol l’accès que vous avez accordé à Discord."
                                   Style="{StaticResource BodyMuted}" />
                        <Button Grid.Column="1"
                                MinHeight="38" Padding="14,7"
                                Content="Révoquer l’autorisation"
                                Style="{StaticResource DangerButton}" />
                    </Grid>
                </Expander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
