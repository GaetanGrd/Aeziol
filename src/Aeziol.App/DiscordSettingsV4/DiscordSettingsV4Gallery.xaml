<UserControl x:Class="Aeziol.App.DiscordSettingsV4.DiscordSettingsV4Gallery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:Aeziol.App.DiscordSettingsV4"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ConceptSelector" TargetType="RadioButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AeziolMuted}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface"
                                CornerRadius="8"
                                Background="{DynamicResource AeziolRaised}"
                                BorderBrush="{DynamicResource AeziolBorderSoft}"
                                BorderThickness="1">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Content}" />
                                <Border x:Name="SelectionMark"
                                        Height="2"
                                        Margin="8,0"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="1"
                                        Background="{DynamicResource AeziolPrimary}"
                                        Opacity="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AeziolSecondary}" />
                                <Setter Property="Foreground" Value="{DynamicResource AeziolText}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AeziolGoldWash}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AeziolPrimary}" />
                                <Setter TargetName="SelectionMark" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource AeziolPrimary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Margin="0,0,0,14"
                Padding="12,9"
                CornerRadius="10"
                Background="{DynamicResource AeziolCanvas}"
                BorderBrush="{DynamicResource AeziolBorderSoft}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{DynamicResource AeziolMuted}"
                           Text="Proposition temporaire" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="Concept1Button" GroupName="DiscordSettingsV4Gallery"
                                 Style="{StaticResource ConceptSelector}" Content="1" Tag="1"
                                 AutomationProperties.Name="Afficher la proposition 1"
                                 Checked="OnConceptSelected" />
                    <RadioButton x:Name="Concept2Button" GroupName="DiscordSettingsV4Gallery"
                                 Style="{StaticResource ConceptSelector}" Content="2" Tag="2"
                                 AutomationProperties.Name="Afficher la proposition 2"
                                 Checked="OnConceptSelected" />
                    <RadioButton x:Name="Concept3Button" GroupName="DiscordSettingsV4Gallery"
                                 Style="{StaticResource ConceptSelector}" Content="3" Tag="3"
                                 AutomationProperties.Name="Afficher la proposition 3"
                                 Checked="OnConceptSelected" />
                    <RadioButton x:Name="Concept4Button" GroupName="DiscordSettingsV4Gallery"
                                 Margin="0"
                                 Style="{StaticResource ConceptSelector}" Content="4" Tag="4"
                                 AutomationProperties.Name="Afficher la proposition 4"
                                 Checked="OnConceptSelected" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ConceptStage" HorizontalAlignment="Stretch">
            <settings:DiscordSettingsV4Concept1 x:Name="Concept1" Visibility="Collapsed" />
            <settings:DiscordSettingsV4Concept2 x:Name="Concept2" Visibility="Collapsed" />
            <settings:DiscordSettingsV4Concept3 x:Name="Concept3" Visibility="Collapsed" />
            <settings:DiscordSettingsV4Concept4 x:Name="Concept4" Visibility="Collapsed" />
        </Grid>
    </StackPanel>
</UserControl>
