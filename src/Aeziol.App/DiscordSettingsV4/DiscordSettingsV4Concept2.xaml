<UserControl x:Class="Aeziol.App.DiscordSettingsV4.DiscordSettingsV4Concept2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Aeziol.App.Controls"
             xmlns:automation="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             Background="Transparent"
             Foreground="{DynamicResource AeziolText}"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="ConceptColumnCard" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{DynamicResource AeziolSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AeziolTraceBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ConceptSettingRow" TargetType="Border">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource AeziolRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AeziolBorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ConceptSettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AeziolText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ConceptSettingHelp" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource AeziolDim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ConceptSectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AeziolText}" />
        </Style>

        <Style x:Key="ConceptLauncherButton"
               TargetType="Button"
               BasedOn="{StaticResource SettingsCommandRow}">
            <Setter Property="MinHeight" Value="74" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="ConceptRoot" MaxWidth="1180">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="DiscordConnectionHost"
                        Margin="0,0,0,8"
                        HorizontalContentAlignment="Stretch" />

        <Grid Grid.Row="1">
            <Grid x:Name="SettingsLauncherPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="OpenGlobalSettingsButton"
                        Grid.Column="0"
                        Tag="Global"
                        Style="{StaticResource ConceptLauncherButton}"
                        Click="OnOpenSettingsModal">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="8"
                                Background="{DynamicResource AeziolGoldWash}">
                            <Path Width="16" Height="16"
                                  Data="M 3,8 L 3,13 L 7,13 L 12,17 L 12,3 L 7,7 L 3,7 Z M 15,7 C 17,9 17,11 15,13"
                                  Stretch="Uniform" Stroke="{DynamicResource AeziolGold}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ConceptSettingTitle}"
                                       Text="Réglages Discord globaux" />
                            <TextBlock Style="{StaticResource ConceptSettingHelp}"
                                       Text="Délai et notifications" />
                        </StackPanel>
                        <Path Grid.Column="2" Width="6" Height="10"
                              Data="M 1,1 L 5,5 L 1,9"
                              Stroke="{DynamicResource AeziolDim}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </Button>

                <Button x:Name="OpenOutputDevicesButton"
                        Grid.Column="2"
                        Tag="Outputs"
                        Style="{StaticResource ConceptLauncherButton}"
                        Click="OnOpenSettingsModal">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="8"
                                Background="{DynamicResource AeziolGoldWash}">
                            <Path Width="16" Height="16"
                                  Data="M 3,5 L 3,15 L 17,15 L 17,5 Z M 6,5 L 7,2 L 13,2 L 14,5 M 6,9 L 14,9"
                                  Stretch="Uniform" Stroke="{DynamicResource AeziolGold}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ConceptSettingTitle}"
                                       Text="Périphériques de sortie" />
                            <TextBlock Style="{StaticResource ConceptSettingHelp}"
                                       Text="Sorties à ne jamais modifier" />
                        </StackPanel>
                        <Path Grid.Column="2" Width="6" Height="10"
                              Data="M 1,1 L 5,5 L 1,9"
                              Stroke="{DynamicResource AeziolDim}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </Button>

                <Button x:Name="OpenFallbackSettingsButton"
                        Grid.Column="4"
                        Tag="Fallback"
                        Style="{StaticResource ConceptLauncherButton}"
                        Click="OnOpenSettingsModal">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="8"
                                Background="{DynamicResource AeziolGoldWash}">
                            <Path Width="16" Height="16"
                                  Data="M 3,4 L 17,4 L 17,16 L 3,16 Z M 6,8 L 14,8 M 6,12 L 11,12"
                                  Stretch="Uniform" Stroke="{DynamicResource AeziolGold}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ConceptSettingTitle}"
                                       Text="Dépannage Discord" />
                            <TextBlock Style="{StaticResource ConceptSettingHelp}"
                                       Text="Détection et chemin manuel" />
                        </StackPanel>
                        <Path Grid.Column="2" Width="6" Height="10"
                              Data="M 1,1 L 5,5 L 1,9"
                              Stroke="{DynamicResource AeziolDim}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </Button>
            </Grid>
        </Grid>

            <Grid x:Name="SettingsModalLayer"
                  Grid.RowSpan="2"
                  MinHeight="360"
                  Visibility="Collapsed"
                  Panel.ZIndex="10"
                  Background="#D9090A0C"
                  MouseLeftButtonUp="OnSettingsModalBackdropClick">
                <Border x:Name="SettingsModalSurface"
                        Width="590"
                        MaxHeight="410"
                        Margin="12"
                        Padding="18,14"
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AeziolSurface}"
                        BorderBrush="{DynamicResource AeziolGoldLine}"
                        BorderThickness="1"
                        MouseLeftButtonUp="OnSettingsModalSurfaceClick">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock x:Name="SettingsModalTitleText"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="SettingsModalCloseButton"
                                    Width="32" Height="32"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource WindowButton}"
                                    Content="×"
                                    Click="OnCloseSettingsModal" />
                        </Grid>

                        <ScrollViewer x:Name="SettingsModalScrollViewer"
                                      Grid.Row="1"
                                      Margin="0,6,4,0"
                                      MaxHeight="330"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <StackPanel x:Name="GlobalSettingsPanel" Visibility="Collapsed">
                                    <Border x:Name="RestoreDelaySetting"
                                            Tag="DiscordSetting:2"
                                            Style="{StaticResource ConceptSettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Style="{StaticResource ConceptSettingTitle}"
                                                           Text="Délai avant restauration de la sortie" />
                                                <TextBlock Style="{StaticResource ConceptSettingHelp}"
                                                           Text="Laissez quelques secondes aux applications pour libérer leur son." />
                                            </StackPanel>
                                            <ComboBox x:Name="RestoreDelayComboBox"
                                                      Grid.Column="1"
                                                      MinHeight="32"
                                                      SelectedIndex="1"
                                                      automation:AutomationProperties.Name="Délai avant restauration de la sortie">
                                                <ComboBoxItem Content="Immédiatement" />
                                                <ComboBoxItem Content="5 secondes" />
                                                <ComboBoxItem Content="10 secondes" />
                                                <ComboBoxItem Content="30 secondes" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <Border Height="1" Margin="8,6"
                                            Background="{DynamicResource AeziolBorderSoft}" />

                                    <Border x:Name="WindowsNotificationSetting"
                                            Tag="DiscordSetting:9"
                                            Style="{StaticResource ConceptSettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource ConceptSettingTitle}"
                                                           Text="Notification Windows" />
                                                <TextBlock Style="{StaticResource ConceptSettingHelp}"
                                                           Text="Prévenez-moi lorsqu'une sortie audio est modifiée." />
                                            </StackPanel>
                                            <CheckBox x:Name="WindowsNotificationToggle"
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      IsChecked="True"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      automation:AutomationProperties.Name="Envoyer une notification Windows lors d'un changement de sortie audio" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Border x:Name="ExcludedOutputsSetting"
                                        Tag="DiscordSetting:3"
                                        Padding="4,2,2,2"
                                        CornerRadius="10"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource AeziolRaised}"
                                        BorderBrush="{DynamicResource AeziolBorderSoft}"
                                        BorderThickness="1">
                                    <ContentControl x:Name="ExcludedOutputsHost"
                                                    MinHeight="150"
                                                    MaxHeight="280"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch" />
                                </Border>

                                <StackPanel x:Name="FallbackSettingsPanel" Visibility="Collapsed">
                                    <StackPanel x:Name="DiscordFallbackHost"
                                                Tag="DiscordSetting:8" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
    </Grid>
</UserControl>
