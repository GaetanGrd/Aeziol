<UserControl x:Class="Aeziol.App.DiscordSettingsV4.DiscordSettingsV4Concept2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Aeziol.App.Controls"
             xmlns:automation="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             Background="Transparent"
             Foreground="{DynamicResource AeziolText}">
    <UserControl.Resources>
        <Style x:Key="ConceptColumnCard" TargetType="Border">
            <Setter Property="Padding" Value="20,18,20,20" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{DynamicResource AeziolSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AeziolTraceBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ConceptSettingRow" TargetType="Border">
            <Setter Property="Padding" Value="14,13" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource AeziolRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AeziolBorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ConceptSettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AeziolText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ConceptSettingHelp" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="LineHeight" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource AeziolDim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ConceptSectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AeziolText}" />
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="ConceptRoot" MaxWidth="1180">
        <ContentControl x:Name="DiscordConnectionHost"
                        Margin="0,0,0,18"
                        HorizontalContentAlignment="Stretch" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="AudioBehaviorColumn"
                        Grid.Column="0"
                        Style="{StaticResource ConceptColumnCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:JourneyTrace x:Name="AudioBehaviorTrace"
                                               Width="24" Height="478"
                                               Margin="0,40,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               IsHitTestVisible="False"
                                               Orientation="Vertical"
                                               EdgeFade="0.12"
                                               BaseStrokeA="0.8"
                                               BaseStrokeB="0.65"
                                               BaseOpacityA="0.52"
                                               BaseOpacityB="0.3"
                                               TraceA="M 12,3 C 6,74 18,130 10,198 C 4,268 19,338 12,475"
                                               TraceB="M 15,4 C 10,72 16,132 13,199 C 9,268 16,339 15,474">
                            <controls:JourneyTrace.Particles>
                                <controls:JourneyParticle X="11" Y="70" Size="2.6" Opacity="0.42" Tone="BlendedPrimary" />
                                <controls:JourneyParticle X="15" Y="198" Size="1.8" Opacity="0.34" Tone="BlendedSecondary" />
                                <controls:JourneyParticle X="9" Y="329" Size="2.3" Opacity="0.4" Tone="BlendedPrimary" />
                                <controls:JourneyParticle X="14" Y="430" Size="1.5" Opacity="0.3" Tone="BlendedSecondary" />
                            </controls:JourneyTrace.Particles>
                        </controls:JourneyTrace>

                        <StackPanel Grid.Column="1">
                            <Grid Margin="2,0,2,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="10"
                                        Background="{DynamicResource AeziolGoldWash}">
                                    <Path Width="17" Height="17"
                                          Data="M 3,8 L 3,13 L 7,13 L 12,17 L 12,3 L 7,7 L 3,7 Z M 15,7 C 17,9 17,11 15,13"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AeziolGold}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource ConceptSectionHeading}"
                                               Text="Comportement audio" />
                                    <TextBlock Margin="0,3,0,0" FontSize="10"
                                               Foreground="{DynamicResource AeziolDim}"
                                               Text="Des réglages simples pour le retour à votre écoute habituelle." />
                                </StackPanel>
                            </Grid>

                            <Border x:Name="RestoreDelaySetting"
                                    Tag="DiscordSetting:2"
                                    Style="{StaticResource ConceptSettingRow}">
                                <StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ConceptSettingTitle}"
                                                   Text="Délai avant restauration de la sortie" />
                                        <TextBlock Style="{StaticResource ConceptSettingHelp}"
                                                   Text="Laissez quelques secondes aux applications pour libérer leur son." />
                                    </StackPanel>
                                    <ComboBox x:Name="RestoreDelayComboBox"
                                              Width="160"
                                              Margin="0,12,0,0"
                                              HorizontalAlignment="Left"
                                              MinHeight="38"
                                              SelectedIndex="1"
                                              automation:AutomationProperties.Name="Délai avant restauration de la sortie">
                                        <ComboBoxItem Content="Immédiatement" />
                                        <ComboBoxItem Content="5 secondes" />
                                        <ComboBoxItem Content="10 secondes" />
                                        <ComboBoxItem Content="30 secondes" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Margin="8,10"
                                    Background="{DynamicResource AeziolBorderSoft}" />

                            <Border x:Name="WindowsNotificationSetting"
                                    Tag="DiscordSetting:9"
                                    Style="{StaticResource ConceptSettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource ConceptSettingTitle}"
                                                   Text="Notification Windows" />
                                        <TextBlock Style="{StaticResource ConceptSettingHelp}"
                                                   Text="Prévenez-moi lorsqu'une sortie audio est modifiée." />
                                    </StackPanel>
                                    <CheckBox x:Name="WindowsNotificationToggle"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              IsChecked="True"
                                              Style="{StaticResource ToggleSwitch}"
                                              automation:AutomationProperties.Name="Envoyer une notification Windows lors d'un changement de sortie audio" />
                                </Grid>
                            </Border>

                            <Border Height="1" Margin="8,10"
                                    Background="{DynamicResource AeziolBorderSoft}" />

                            <Border x:Name="ExcludedOutputsSetting"
                                    Tag="DiscordSetting:3"
                                    Style="{StaticResource ConceptSettingRow}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ConceptSettingTitle}"
                                               Text="Sorties à ne jamais modifier" />
                                    <TextBlock Style="{StaticResource ConceptSettingHelp}"
                                               Text="Cochez les appareils qui doivent toujours rester intacts." />
                                    <StackPanel Margin="0,9,0,0">
                                        <CheckBox Style="{StaticResource DeviceCheck}" IsChecked="True"
                                                  Content="Casque USB" />
                                        <CheckBox Style="{StaticResource DeviceCheck}"
                                                  Content="Haut-parleurs du moniteur" />
                                        <CheckBox Style="{StaticResource DeviceCheck}"
                                                  Content="Sortie HDMI" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="DiscordInstallationColumn"
                        Grid.Column="2"
                        Style="{StaticResource ConceptColumnCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:JourneyTrace x:Name="DiscordInstallationTrace"
                                               Width="24" Height="478"
                                               Margin="0,40,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               IsHitTestVisible="False"
                                               Orientation="Vertical"
                                               EdgeFade="0.12"
                                               BaseStrokeA="0.8"
                                               BaseStrokeB="0.65"
                                               BaseOpacityA="0.52"
                                               BaseOpacityB="0.3"
                                               TraceA="M 12,3 C 18,80 5,143 13,217 C 20,289 7,366 12,475"
                                               TraceB="M 15,4 C 17,80 9,144 15,218 C 18,290 11,367 15,474">
                            <controls:JourneyTrace.Particles>
                                <controls:JourneyParticle X="13" Y="79" Size="2.5" Opacity="0.4" Tone="BlendedSecondary" />
                                <controls:JourneyParticle X="10" Y="216" Size="1.7" Opacity="0.3" Tone="BlendedPrimary" />
                                <controls:JourneyParticle X="15" Y="354" Size="2.4" Opacity="0.4" Tone="BlendedSecondary" />
                            </controls:JourneyTrace.Particles>
                        </controls:JourneyTrace>

                        <StackPanel Grid.Column="1">
                            <Grid Margin="2,0,2,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="10"
                                        Background="{DynamicResource AeziolGoldWash}">
                                    <Path Width="17" Height="17"
                                          Data="M 3,5 L 3,15 L 17,15 L 17,5 Z M 6,5 L 7,2 L 13,2 L 14,5 M 6,9 L 14,9"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AeziolGold}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource ConceptSectionHeading}"
                                               Text="Installation Discord" />
                                    <TextBlock Margin="0,3,0,0" FontSize="10"
                                               Foreground="{DynamicResource AeziolDim}"
                                               Text="Aeziol retrouve normalement l'application sans votre aide." />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="DiscordFallbackHost"
                                        Tag="DiscordSetting:8" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
    </StackPanel>
</UserControl>
